# Domain
# This would be set to the production domain with an env var on deployment
DOMAIN=

# Environment: local, staging, production
ENVIRONMENT=

PROJECT_NAME=
STACK_NAME=

# Backend
BACKEND_CORS_ORIGINS=
USERS_OPEN_REGISTRATION=

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
SMTP_TLS=
SMTP_SSL=
SMTP_PORT=

# Postgres
POSTGRES_SERVER=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

SENTRY_DSN=

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=
DOCKER_IMAGE_FRONTEND=

# Auth0
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=

AUTH0_MGMT_API_CLIENT_ID=
AUTH0_MGMT_API_CLIENT_SECRET=
AUTH0_MGMT_API_AUDIENCE=

# Database URLs (for local scripts running outside Docker)
# Set these to localhost for running scripts from host machine
DATABASE_URL=  # e.g., postgresql+psycopg2://postgres:changethis@localhost:5432/app
ASYNC_DATABASE_URL=  # e.g., postgresql+asyncpg://postgres:changethis@localhost:5432/app

# AWS / MinIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_ENDPOINT_URL=  # Optional: Set to http://minio:9000 for local MinIO

#MODAL
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENVIRONMENT=
